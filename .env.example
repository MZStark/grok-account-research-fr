# xAI (Grok) API key: https://console.x.ai
XAI_API_KEY=
# Grok model to use (any model available on your account)
GROK_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Web search for step 1: "grok" (built-in web_search tool) or "tavily"
SEARCH_PROVIDER=grok
TAVILY_API_KEY=

REQUEST_TIMEOUT_S=300
MAX_RETRIES=3
